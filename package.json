    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --compile --outfile dist/eblib"
  },
  "dependencies": {
    "@epubkit/core": "file:../epubkit/packages/core",
    "cac": "^6.7.14",
    "cheerio": "^1.2.0",
    "domhandler": "5.0.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
