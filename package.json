{
  "name": "eblib",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Scrape Ebangla Library books into clean Bengali EPUBs. Personal use only.",
  "license": "MIT",
  "bin": {
    "eblib": "./src/cli.ts"
  },
